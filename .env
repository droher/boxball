# Retrosheet: canonical alldata.zip from retrosheet.org. URL is mutable, so the
# build pins the dataset by sha256 instead of git SHA. Bump RELEASE_DATE for humans
# and SHA256 for the integrity check whenever Retrosheet ships a new release.
# When retrosheet.org publishes a new release the URL stays the same but the body
# changes; sha256sum -c will then fail every build until both fields are bumped.
RETROSHEET_RELEASE_DATE=2025-12
RETROSHEET_SHA256=88fbc6a2e179a3174d13d688b761b096671b9121f0d5e88bcdae0272557b1a14

CHADWICK_VERSION=c685ab51abd769978bec3ceab38c4ae0c760d6de

# Baseball Databank: chadwickbureau/baseballdatabank was retired in 2024.
# corbtastik/lahman-baseball-db hosts the canonical SABR Lahman v2025 release
# (Dec 10, 2025) as a flat tree of CSVs at the repo root.
BASEBALLDATABANK_VERSION=b5e7327707fff91ff3bdcbe1f6892c8c5015cf1d

EXTRACT_DIR=extract
REPO=doublewick/boxball
VERSION=2026.0.0
BUILD_ENV=prod
